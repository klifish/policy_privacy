+        test = split_pair(pair["y"], pair["o"], 3, "semantic_equivalent-0")
+        for side in (0, 1):
+            for o in (0, 1):
+                cell = (pair["y"] == side) & (pair["o"] == o)
+                self.assertEqual(int(test[cell].sum()), 3)
