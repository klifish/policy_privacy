-    }
-    byType.get(entry.pairType).push(entry);
-  });
-
-  const aggregated = Array.from(byType.entries()).map(([pairType, entries]) => {
-    const meanMmd = entries.reduce((acc, item) => acc + item.mmd, 0) / entries.length;
