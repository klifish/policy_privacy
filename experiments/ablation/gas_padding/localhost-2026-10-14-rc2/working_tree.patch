+      const labels = cell.labels.slice();
+      for (let j = labels.length - 1; j > 0; j--) {
+        const k = Math.floor(rng() * (j + 1));
+        [labels[j], labels[k]] = [labels[k], labels[j]];
+      }
+      return calculateAUC(labels, cell.scores);
+    });
+    if (mean(permuted) >= auc) count += 1;
