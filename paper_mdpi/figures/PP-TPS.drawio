<mxfile host="drawio"><diagram id="pp-tps" name="TPS-ZKPI workflow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bnd" value="Provider&amp;ndash;TPS boundary (off-chain)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontFamily=Helvetica;fontStyle=2;fillColor=none;dashed=1;dashPattern=8 5;strokeColor=#555555;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="790" height="200" as="geometry"/></mxCell><mxCell id="pub" value="Public chain (visible to any observer)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontFamily=Helvetica;fontStyle=2;fillColor=#eeeeee;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="560" height="230" as="geometry"/></mxCell><mxCell id="prov" value='&lt;div style="text-align:center;"&gt;&lt;b style="font-size:17px;"&gt;Provider&lt;/b&gt;&lt;/div&gt;&lt;ul style="margin:8px 0 0 0;padding-left:20px;"&gt;&lt;li&gt;Defines consent policy &lt;i&gt;P&lt;/i&gt;&lt;/li&gt;&lt;li&gt;Encodes &lt;i&gt;P&lt;/i&gt; as &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;enc&lt;/sub&gt;&lt;/li&gt;&lt;li&gt;Computes commitments &lt;i&gt;h&lt;/i&gt; and &lt;i&gt;pp&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=15;fontFamily=Helvetica;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="280" height="135" as="geometry"/></mxCell><mxCell id="tps" value='&lt;div style="text-align:center;"&gt;&lt;b style="font-size:17px;"&gt;Trusted Proof Service (TPS)&lt;/b&gt;&lt;/div&gt;&lt;ul style="margin:8px 0 0 0;padding-left:20px;"&gt;&lt;li&gt;Constructs the private witness &lt;i&gt;w&lt;/i&gt;&lt;/li&gt;&lt;li&gt;Generates the zero-knowledge proof &amp;pi;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=15;fontFamily=Helvetica;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="310" height="135" as="geometry"/></mxCell><mxCell id="req" value='&lt;div style="text-align:center;"&gt;&lt;b style="font-size:17px;"&gt;Requester&lt;/b&gt;&lt;/div&gt;&lt;ul style="margin:8px 0 0 0;padding-left:20px;"&gt;&lt;li&gt;Holds attributes and credentials&lt;/li&gt;&lt;li&gt;Requests the protected resource after authorization&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=15;fontFamily=Helvetica;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="270" height="135" as="geometry"/></mxCell><mxCell id="acm" value='&lt;div style="text-align:center;"&gt;&lt;b style="font-size:17px;"&gt;Access-Control Manager (ACM)&lt;/b&gt;&lt;/div&gt;&lt;ul style="margin:8px 0 0 0;padding-left:20px;"&gt;&lt;li&gt;Stores commitments &lt;i&gt;h&lt;/i&gt; and &lt;i&gt;pp&lt;/i&gt;&lt;/li&gt;&lt;li&gt;Checks context digest &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;&amp;chi;&lt;/sub&gt;, nonce, and epoch &amp;tau;&lt;/li&gt;&lt;li&gt;Verifies &amp;pi; against the public signals&lt;/li&gt;&lt;li&gt;&lt;b&gt;5.&lt;/b&gt; Records the outcome; emits a granted or denied event&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=15;fontFamily=Helvetica;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="310" height="170" as="geometry"/></mxCell><mxCell id="dal" value='&lt;div style="text-align:center;"&gt;&lt;b style="font-size:17px;"&gt;Data Access Layer&lt;/b&gt;&lt;/div&gt;&lt;ul style="margin:8px 0 0 0;padding-left:20px;"&gt;&lt;li&gt;Guards the protected resource&lt;/li&gt;&lt;li&gt;Serves or refuses each request according to the recorded outcome&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=15;fontFamily=Helvetica;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="310" height="110" as="geometry"/></mxCell><mxCell id="e1" value="1. Commit &lt;i&gt;h&lt;/i&gt;, &lt;i&gt;pp&lt;/i&gt;&lt;br&gt;(gas-padded tx)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prov" target="acm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Policy-bound&lt;br&gt;proving material" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prov" target="tps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Authorization&lt;br&gt;evidence + context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="tps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4. Proof &amp;pi;, public signals, context&lt;br&gt;(gas-padded tx)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tps" target="acm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="6. Request&lt;br&gt;protected resource" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="dal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="9. Data access /&lt;br&gt;access denied" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dal" target="req"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="7. Check&lt;br&gt;outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dal" target="acm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="8. Recorded&lt;br&gt;outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endSize=8;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="acm" target="dal"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>