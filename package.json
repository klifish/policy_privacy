{
  "name": "zero-knowledge-proof-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "debug:compile": "npx circom2 circuits/postfix_policy_interpreter.circom --r1cs --wasm --sym -o debug",
    "debug:witness": "npx snarkjs wtns calculate debug/postfix_policy_interpreter_js/postfix_policy_interpreter.wasm debug/input.json debug/witness.wtns",
    "debug": "npm run debug:compile && npm run debug:witness",
    "test": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/postfix_policy_interpreter*.js --timeout 100000",
    "test:all": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/*.js --timeout 100000",
    "test:circuits": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/commitment_gadgets.js test/external_predicates.js test/policy_interpreter.js --timeout 100000",
    "test:functional": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/policy_privacy_main_test.js test/policy_privacy_phase1_integration.js test/comprehensive_functional.js --timeout 100000",
    "test:comprehensive": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/comprehensive_functional.js --timeout 100000",
    "test:compiler": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/compiler/*.js --timeout 100000",
    "test:legacy": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/postfix_policy_interpreter.js --timeout 100000",
    "test:extended": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/postfix_policy_interpreter_extended.js --timeout 100000",
    "test:phase1": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/policy_privacy_phase1_integration.js --timeout 100000",
    "build:circuit:compile:postfixpolicyinterpreter": "npx circom2 circuits/postfix_policy_interpreter_legacy.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:main": "npx circom2 circuits/policy_privacy_main_instance.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:main": "npx circom2 test/circuits/test_policy_privacy_main.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:policy_commitment": "npx circom2 test/circuits/test_policy_commitment.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:merkle": "npx circom2 test/circuits/test_merkle_proof_verifier.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:credential": "npx circom2 test/circuits/test_credential_signature.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:range": "npx circom2 test/circuits/test_range_proof.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:ontology": "npx circom2 test/circuits/test_ontology_linked_terms.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:multimux": "npx circom2 test/circuits/test_multimux.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:test:interpreter": "npx circom2 test/circuits/test_postfix_policy_interpreter_extended.circom --r1cs --wasm --sym -o build/circuits -l node_modules",
    "build:circuit:compile:all": "mkdir -p build/circuits && npm run build:circuit:compile:main && npm run build:circuit:compile:postfixpolicyinterpreter && npm run build:circuit:compile:test:main && npm run build:circuit:compile:test:policy_commitment && npm run build:circuit:compile:test:merkle && npm run build:circuit:compile:test:credential && npm run build:circuit:compile:test:range && npm run build:circuit:compile:test:ontology && npm run build:circuit:compile:test:multimux && npm run build:circuit:compile:test:interpreter",
    "build:circuit:compile": "mkdir -p build/circuits && npm run build:circuit:compile:all",
    "build:circuit:info": "for file in build/circuits/*.r1cs; do echo \"$file...\"; npx snarkjs r1cs info \"$file\"; done",
    "build:circuit:setup": "node scripts/groth16_trust_setup.js",
    "build:circuit:export:verificationkey": "npx snarkjs zkey export verificationkey build/circuits/policy_privacy_main_final.zkey build/circuits/policy_privacy_main_vk.json",
    "build:circuit:export:solidityverifier": "mkdir -p contracts && npx snarkjs zkey export solidityverifier build/circuits/policy_privacy_main_final.zkey contracts/PolicyPrivacyMainVerifier.sol && node scripts/fix_verifier_contract_name.js",
    "build:circuit": "npm run build:circuit:compile && npm run build:circuit:info",
    "build:circuit:full": "npm run build:circuit:compile && npm run build:circuit:info && npm run build:circuit:setup && npm run build:circuit:export:verificationkey && npm run build:circuit:export:solidityverifier",
    "hardhat:test": "npx hardhat test",
    "hardhat:test:verbose": "npx hardhat test --verbose",
    "api:start": "node api/server.js",
    "api:dev": "nodemon api/server.js",
    "api:test": "mocha test/api/*.js --timeout 10000",
    "demo": "node scripts/demo.js",
    "setup": "node scripts/setup.js",
    "visualize-circuit": "node scripts/generate_circuit_visualization.js",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "experiment:policy:pch": "node experiments/policy_content_hiding/run_experiment.js",
    "experiment:policy:pch:phase1": "node experiments/policy_content_hiding/run_experiment.js --phase 1",
    "experiment:policy:pch:phase2": "node experiments/policy_content_hiding/run_experiment.js --phase 2 --execution-results experiments/policy_content_hiding/results/execution_results.json",
    "experiment:policy:pch:phase3": "node experiments/policy_content_hiding/run_experiment.js --phase 3 --features experiments/policy_content_hiding/results/features.json",
    "experiment:policy:pch:amoy": "npx hardhat run experiments/policy_content_hiding/run_experiment.js --network polygonAmoy",
    "experiment:policy:pi": "node experiments/policy_indistinguishability/run_experiment.js --policy-count 100 --executions-per-policy 2",
    "experiment:policy:pi:nohup": "nohup node experiments/policy_indistinguishability/run_experiment.js --resume > experiments/policy_indistinguishability/nohup.out 2>&1 &",
    "experiment:policy:pi:phase1": "node experiments/policy_indistinguishability/run_experiment.js --phase 1",
    "experiment:policy:pi:phase2": "node experiments/policy_indistinguishability/run_experiment.js --phase 2 --execution-results experiments/policy_indistinguishability/results/pi_execution_results.json",
    "experiment:policy:pi:phase3": "node experiments/policy_indistinguishability/run_experiment.js --phase 3 --pairs experiments/policy_indistinguishability/results/pi_pairs.json",
    "experiment:policy:spp": "node experiments/structure_and_parameter_privacy/run_experiment.js",
    "experiment:policy:spp:phase1": "node experiments/structure_and_parameter_privacy/run_experiment.js --phase 1",
    "experiment:policy:spp:phase2": "node experiments/structure_and_parameter_privacy/run_experiment.js --phase 2 --execution-results experiments/structure_and_parameter_privacy/results/execution_results.json",
    "experiment:policy:spp:test": "node experiments/structure_and_parameter_privacy/run_experiment.js --policies-per-family 3 --executions-per-policy 2 --output experiments/structure_and_parameter_privacy/results/test",
    "test:experiments:spp": "PATH=$PWD/node_modules/.bin:$PATH npx mocha test/experiments/structure_parameter_privacy_test.js --timeout 100000",
    "experiment:policy:unified": "UNIFIED_CONFIG_PATH=experiments/unified_dataset_config_optimized.json npx hardhat run experiments/run_unified_dataset.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "axios": "^1.12.2",
    "circom": "^0.5.46",
    "circom2": "^0.2.22",
    "dotenv": "^16.4.5",
    "hardhat": "^2.26.3",
    "mocha": "^11.7.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "circom_tester": "^0.0.20",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "ffjavascript": "^0.3.1",
    "helmet": "^6.1.5",
    "snarkjs": "^0.7.5",
    "uuid": "^9.0.0"
  }
}